# ── Core ─────────────────────────────────────────────────────────────────────
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-for-local-development
# Comma-separated client IPs allowed to see Django Debug Toolbar in debug mode.
DJANGO_INTERNAL_IPS=127.0.0.1

# Comma-separated list of allowed hostnames (leave blank for local dev)
# DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# App-specific cookie names prevent other localhost apps from replacing sign-in.
# Use distinct names if running multiple copies on the same hostname.
# DJANGO_SESSION_COOKIE_NAME=microcredit_sessionid
# DJANGO_CSRF_COOKIE_NAME=microcredit_csrftoken

# Production: set DEBUG=False, generate a long random secret, and configure hosts.
# HTTPS protections default to enabled when DEBUG=False.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
# DJANGO_TRUST_PROXY_HTTPS=True

# Staff and field officers enroll an authenticator before accessing their workspaces.
STAFF_MFA_REQUIRED=True
# Generate an independent Fernet key; keep it in the production environment.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MFA_ENCRYPTION_KEYS=primary-key,previous-key-during-rotation
# Trust only documented proxy address ranges; leave blank for direct connections.
TRUSTED_PROXY_CIDRS=
# Set a random token for the protected /health/ endpoint. Send it as a Bearer header.
HEALTHCHECK_TOKEN=

# Timezone (e.g. Africa/Accra, Africa/Lagos, Africa/Nairobi)
TIME_ZONE=Africa/Accra

# ── Database ──────────────────────────────────────────────────────────────────
# Local development default
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# PythonAnywhere MySQL production example. The full database name includes
# your PythonAnywhere username and a dollar sign, e.g. allgift$sikafriend.
# DB_ENGINE=mysql
# DB_NAME=yourusername$sikafriend
# DB_USER=yourusername
# DB_PASSWORD=your-mysql-password
# DB_HOST=yourusername.mysql.pythonanywhere-services.com
# DB_PORT=3306
# DB_CONN_MAX_AGE=60
# Optional: create this database separately before running Django tests.
# DB_TEST_NAME=yourusername$test_sikafriend

# Temporary source database for the legacy-data importer. Keep DB_NAME pointed
# at the new database; the importer only reads from this separate database.
# LEGACY_DB_NAME=yourusername$legacy
# LEGACY_DB_USER=yourusername
# LEGACY_DB_PASSWORD=your-mysql-password
# LEGACY_DB_HOST=yourusername.mysql.pythonanywhere-services.com
# LEGACY_DB_PORT=3306

# ── Email ─────────────────────────────────────────────────────────────────────
# Console backend prints emails to terminal (good for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@microcredit.local

# Uncomment and fill in for real email delivery (SMTP)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=true

# ── SMS (Arkesel) ─────────────────────────────────────────────────────────────
# ARKESEL_API_KEY=your-arkesel-api-key
# ARKESEL_SENDER_ID=YourBrand

# ── Payment webhooks ─────────────────────────────────────────────────────────
# PAYMENT_WEBHOOK_SECRET=your-webhook-secret
